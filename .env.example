# Copia este fichero a .env y rellena los valores.
# .env está en .gitignore: nunca lo subas al repositorio.

# Supabase → Project Settings → API
# La clave "anon public" es pública por diseño: viaja en el bundle del
# navegador y lo que protege los datos es Row Level Security, no ella.
# La que NUNCA sale del panel es la "service_role".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Fecha de la última rotación de credenciales (AAAA-MM-DD).
# La leen `npm run secrets:check` y la pantalla de Estado del panel.
VITE_SECRETS_ROTATED_AT=

# --- Opcionales -----------------------------------------------------

# Monitorización de errores. Sin DSN no se carga ni se envía nada.
# VITE_SENTRY_DSN=

# Banderas: apagar una función sin desplegar código nuevo.
# VITE_FLAG_MODO_PEQUE=1     pantalla infantil propia para el rol peque
# VITE_FLAG_LOGS_REMOTOS=1   guardar logs de warn/error en Supabase
# VITE_FLAG_LOGS_INFO=0      guardar además los informativos (ruidoso)

# Backend simulado en el navegador, sin Supabase. Para probar la app.
# VITE_DEMO=1

# URL publicada, para `npm run health` sin argumentos. Si no se pone, los
# scripts la deducen de public/CNAME (dominio propio) o del remoto.
# HEALTH_URL=https://tu-dominio/
